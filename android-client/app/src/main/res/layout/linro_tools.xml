<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/toolsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="도구 및 연결" android:textSize="25sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="현재 연결에서 사용할 도구를 선택하세요." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/toolsConnectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PC 연결 없음" android:textSize="12sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" android:layout_marginTop="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="원격 도구" android:textSize="13sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/sendFileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="파일을 PC로 보내기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_files" android:drawablePadding="14dp" />
            <Button android:id="@+id/receiveFileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="PC 파일 수신 승인" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_files" android:drawablePadding="14dp" />
            <Button android:id="@+id/sendClipboardButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="클립보드 텍스트 보내기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_clipboard" android:drawablePadding="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="파일과 클립보드는 실제 PC 연결 중에만 보낼 수 있습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
            <Button android:id="@+id/audioPermissionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="재생 소리 권한 설정" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_audio" android:drawablePadding="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="소리는 PC 웹에서 켭니다. 마이크 소리는 보내지 않습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="연결 관리" android:textSize="13sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/standbyModeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="대기 모드 선택" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_power" android:drawablePadding="14dp" />
            <Button android:id="@+id/diagnosticsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="로컬 진단 보기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_stats" android:drawablePadding="14dp" />
            <Button android:id="@+id/exportDiagnosticsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="진단 JSON 내보내기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_stats" android:drawablePadding="14dp" />
            <Button android:id="@+id/cancelTransferButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="파일 전송 취소" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_close" android:drawablePadding="14dp" />
            <Button android:id="@+id/remoteToolsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="모든 전송 도구 보기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_devices" android:drawablePadding="14dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="화면 캡처·녹화는 연결된 PC 웹에서 실행합니다. 이 앱에서 별도 녹화를 시작하지 않습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
