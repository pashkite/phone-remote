<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settingsPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="설정" android:textSize="25sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="연결 권한과 앱 환경을 직접 관리하세요." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="앱 환경" android:textSize="13sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/appearanceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="외관 · 시스템 설정" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_moon" android:drawablePadding="14dp" />
            <TextView android:id="@+id/appearanceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="시스템 설정 사용" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
            <Button android:id="@+id/notificationSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="알림 설정" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_bell" android:drawablePadding="14dp" />
            <Button android:id="@+id/listenerSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="연결 요청 대기 관리" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_link" android:drawablePadding="14dp" />
            <TextView android:id="@+id/listenerSettingsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="대기 상태 확인 중" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="조작 권한" android:textSize="13sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/accessibilityStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="접근성 설정에서 린로 조작을 허용해 주세요." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
            <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="접근성 설정 열기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_shield" android:drawablePadding="14dp" />
            <TextView android:id="@+id/keyboardStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="원격 키보드는 선택 사항입니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="18dp" />
            <Button android:id="@+id/keyboardButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="원격 키보드 켜기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_keyboard" android:drawablePadding="14dp" />
            <Button android:id="@+id/settingsAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="오디오 권한 · 안내" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_audio" android:drawablePadding="14dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="앱 정보" android:textSize="13sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/appVersionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="버전 확인 중" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" />
            <Button android:id="@+id/settingsConnectionInfoButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="테스트 연결 정보" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_stats" android:drawablePadding="14dp" />
            <Button android:id="@+id/experimentButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="물리 패널 OFF 실험 · 미검증" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_power" android:drawablePadding="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="실험은 실제 패널과 외부 복구 경로를 검증한 뒤에만 수행하세요. 화면 잠금과 패널 전원 OFF는 다릅니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
