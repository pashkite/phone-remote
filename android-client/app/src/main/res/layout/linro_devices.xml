<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/devicesPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="내 기기" android:textSize="25sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이 휴대폰의 계정 등록과 연결 주소를 관리합니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="등록 정보" android:textSize="12sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/registeredDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이 휴대폰" android:textSize="18sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/deviceRegistrationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="기기 등록 상태 확인 중" android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/registeredOrigin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="연결 주소 확인 중" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:textIsSelectable="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="기기 등록" android:textSize="18sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" />
            <TextView android:id="@+id/pairingDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PC 사이트에 로그인해 만든 6자리 코드를 입력하세요. 비밀번호는 앱에 저장되지 않습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" />
            <EditText android:id="@+id/pairingCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="18dp" android:autofillHints="oneTimeCode" android:background="@drawable/bg_input" android:digits="0123456789" android:gravity="center" android:hint="6자리 등록 코드" android:importantForAutofill="yes" android:inputType="number" android:maxLength="6" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="20sp" />
            <Button android:id="@+id/pairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:padding="14dp" android:text="기기 등록" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/on_primary" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_link" android:drawablePadding="14dp" />
            <Button android:id="@+id/editRegistrationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="기기 등록 변경" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_refresh" android:drawablePadding="14dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="저장된 등록 정보의 서버 유효성은 실제 요청 시 확인됩니다. 연결된 PC의 목록을 임의로 표시하지 않습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
