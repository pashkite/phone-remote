<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:visibility="visible">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="당신의 기기를, 더 가까이" android:textSize="25sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="휴대폰에서 허용한 동안 안전하게 연결합니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="연결 상태" android:textSize="12sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/statusHeadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="연결 준비 중" android:textSize="27sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:textStyle="bold" />
            <TextView android:id="@+id/statusBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="설정 필요" android:textSize="12sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/standbyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="등록과 권한 상태를 확인하고 있습니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" />
            <Button android:id="@+id/standbyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:padding="14dp" android:text="연결 요청 알림 켜기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/on_primary" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_link" android:drawablePadding="14dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_surface">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="현재 기기" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/homeDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이 휴대폰" android:textSize="18sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:textStyle="bold" />
            <TextView android:id="@+id/homeDeviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="등록 정보 확인 중" android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" />
        </LinearLayout>
        <Button android:id="@+id/homePairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="기기 등록 · 연결 관리" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_phone" android:drawablePadding="14dp" />
        <Button android:id="@+id/homeAccessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="접근성 권한 확인" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_shield" android:drawablePadding="14dp" />
        <Button android:id="@+id/homeWaitingButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_secondary" android:backgroundTint="@null" android:padding="14dp" android:text="연결 요청 알림 관리" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_bell" android:drawablePadding="14dp" />
        <Button android:id="@+id/connectionInfoButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary" android:backgroundTint="@null" android:padding="14dp" android:text="연결 정보 보기" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/on_primary" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_ui_stats" android:drawablePadding="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="화면 공유 승인은 Android 시스템에서 세션별로 확인합니다. 자동 연결 준비를 허용하면 공유를 중지할 때까지 추가 승인 없이 연결됩니다." android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
