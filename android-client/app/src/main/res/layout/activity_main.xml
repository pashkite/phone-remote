<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/appRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="16dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Linro" android:contentDescription="린로 Linro" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/headerSettingsButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_nav_item" android:src="@drawable/ic_ui_settings" android:contentDescription="설정 탭 열기" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include layout="@layout/linro_home" />
        <include layout="@layout/linro_tools" />
        <include layout="@layout/linro_devices" />
        <include layout="@layout/linro_settings" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:orientation="horizontal" android:background="@color/surface" android:baselineAligned="false">
        <Button android:id="@+id/navHome" style="@style/Linro.NavigationButton" android:text="홈" android:drawableTop="@drawable/ic_ui_home" android:contentDescription="홈 탭" />
        <Button android:id="@+id/navTools" style="@style/Linro.NavigationButton" android:text="도구" android:drawableTop="@drawable/ic_ui_link" android:contentDescription="도구 탭" />
        <Button android:id="@+id/navDevices" style="@style/Linro.NavigationButton" android:text="기기" android:drawableTop="@drawable/ic_ui_phone" android:contentDescription="기기 탭" />
        <Button android:id="@+id/navSettings" style="@style/Linro.NavigationButton" android:text="설정" android:drawableTop="@drawable/ic_ui_settings" android:contentDescription="설정 탭" />
    </LinearLayout>
</LinearLayout>
