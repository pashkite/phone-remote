<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="24dp" android:paddingEnd="22dp" android:paddingBottom="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" android:src="@mipmap/ic_launcher" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="내 갤럭시를 어디서든 안전하게" android:textColor="@color/muted" android:textSize="14sp" />
            </LinearLayout>
            <TextView android:id="@+id/statusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status" android:text="설정 필요" android:textColor="@color/primary_dark" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="연결 상태" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="연결 준비" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/standbyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" android:text="PC에서 연결 시작을 누르면 이 기기에 승인·거절 알림이 도착합니다." android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/standbyButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_primary" android:text="연결 요청 알림 켜기" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기기 등록" android:textAllCaps="true" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="이 기기 등록" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/pairingDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" android:text="PC 사이트에 로그인해 만든 6자리 코드를 입력하세요. 비밀번호는 앱에 저장되지 않습니다." android:textColor="@color/muted" android:textSize="14sp" />
            <EditText android:id="@+id/pairingCode" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:autofillHints="oneTimeCode" android:background="@drawable/bg_input" android:digits="0123456789" android:gravity="center" android:hint="000 000" android:importantForAutofill="yes" android:inputType="number" android:letterSpacing="0.2" android:maxLength="6" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="#9BA9BA" android:textSize="22sp" android:textStyle="bold" />
            <Button android:id="@+id/pairButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_primary" android:text="기기 등록" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/editRegistrationButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="기기 등록 변경" android:textAllCaps="false" android:textSize="14sp" android:background="@drawable/bg_secondary" android:textColor="@color/primary_dark" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="필수 설정" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="조작 권한 켜기" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/accessibilityStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" android:text="접근성 설정에서 Galaxy Remote 2.0 조작을 허용해 주세요." android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_secondary" android:text="접근성 설정 열기" android:textAllCaps="false" android:textColor="@color/primary_dark" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="선택 설정" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="원격 키보드 (선택)" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/keyboardStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="3dp" android:text="Discord 같은 채팅 앱에서 입력이 정확하게 들어가도록 해 줍니다." android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/keyboardButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_secondary" android:text="원격 키보드 켜기" android:textAllCaps="false" android:textColor="@color/primary_dark" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_secondary" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="◇" android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:lineSpacingExtra="2dp" android:text="일반 연결은 휴대폰에서 승인합니다. 자동 연결 준비 중에는 추가 승인 없이 연결됩니다. 화면 공유 중지로 자동 연결을 끌 수 있습니다." android:textColor="@color/muted" android:textSize="14sp" />
        </LinearLayout>
        <Button android:id="@+id/remoteToolsButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="전송 · 대기 모드 · 진단" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
