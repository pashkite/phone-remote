<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Theme.GalaxyRemote" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorBackground">@color/page</item>
    </style>
    <style name="Linro.NavigationButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textColor">@color/nav_tint</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
